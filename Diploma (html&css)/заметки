import { betterSlider } from "./better-slider.js";

document.addEventListener("DOMContentLoaded", () => {
  const header = document.querySelector(".header");

  window.addEventListener("scroll", () => {
    // Если прокрутили страницу вниз более чем на 40px
    if (window.scrollY > 40) {
      header.classList.add("header--scrolled");
    } else {
      header.classList.remove("header--scrolled");
    }
  });
});

try {
  betterSlider();
} catch (error) {
  console.error(error);
}

document.addEventListener("DOMContentLoaded", () => {
  const tbody = document.getElementById("timetable-tbody");
  const tabs = document.querySelectorAll(".timetable__tab-btn");

  if (!tbody) return;

  // 1. ЗАПОМИНАЕМ ИСХОДНЫЙ HTML И СТРОИМ СЕТКУ
  const initialAllHtml = tbody.innerHTML;
  const parsedData = [];

  // Вспомогательный массив для отслеживания перекрытий от rowspan по дням (0-6)
  // Инициализируем нулями для 7 дней недели
  let rowspanCounters = Array(7).fill(0);

  const originalRows = tbody.querySelectorAll("tr");
  originalRows.forEach((tr) => {
    const timeCell = tr.querySelector(".timetable__cell-time");
    if (!timeCell) return;

    const rowObj = {
      time: timeCell.textContent.trim(),
      cells: Array(7).fill(null), // Создаем жесткую структуру из 7 дней для этой строки
    };

    const dayCells = tr.querySelectorAll("td:not(.timetable__cell-time)");
    let htmlCellIndex = 0;

    // Математически точно распределяем ячейки по реальным дням недели (с учетом прошлых rowspan)
    for (let dayIndex = 0; dayIndex < 7; dayIndex++) {
      // Если этот день еще перекрыт rowspan-ом из предыдущей строки, уменьшаем счетчик и пропускаем
      if (rowspanCounters[dayIndex] > 0) {
        rowspanCounters[dayIndex]--;
        continue;
      }

      // Если в HTML еще остались ячейки для этого ряда
      if (htmlCellIndex < dayCells.length) {
        const td = dayCells[htmlCellIndex];
        const lesson = td.querySelector(".timetable__lesson");

        const cellObj = {
          isExist: true,
          rowspan: td.hasAttribute("rowspan")
            ? parseInt(td.getAttribute("rowspan"), 10)
            : 1,
        };

        if (lesson) {
          cellObj.name =
            lesson
              .querySelector(".timetable__lesson-name")
              ?.textContent.trim() || "";
          cellObj.coach =
            lesson
              .querySelector(".timetable__lesson-coach")
              ?.textContent.trim() || "";
          cellObj.type = lesson.getAttribute("data-type") || "";
        }

        // Запоминаем текущий rowspan для следующих строк
        if (cellObj.rowspan > 1) {
          rowspanCounters[dayIndex] = cellObj.rowspan - 1;
        }

        rowObj.cells[dayIndex] = cellObj;
        htmlCellIndex++;
      }
    }

    parsedData.push(rowObj);
  });

  // 2. УМНАЯ ОТРИСОВКА СЕТКИ
  function updateTable(filter) {
    // Если выбран "all", просто возвращаем сочный родной HTML с rowspan-ами из верстки
    if (filter === "all") {
      tbody.innerHTML = initialAllHtml;
      return;
    }

    tbody.innerHTML = "";

    // Отслеживаем rowspan для отрисовки изолированных табов
    let activeRowspanCounters = Array(7).fill(0);

    parsedData.forEach((row) => {
      const tr = document.createElement("tr");

      // Добавляем время
      const timeTd = document.createElement("td");
      timeTd.className = "timetable__cell-time";
      timeTd.textContent = row.time;
      tr.appendChild(timeTd);

      // Идем строго по 7 дням недели (от 0 до 6)
      for (let dayIndex = 0; dayIndex < 7; dayIndex++) {
        // Если день занят rowspan-ом активной карточки из верхней строки, пропускаем его создание
        if (activeRowspanCounters[dayIndex] > 0) {
          activeRowspanCounters[dayIndex]--;
          continue;
        }

        const cellData = row.cells[dayIndex];
        const td = document.createElement("td");

        // Проверяем, есть ли в этот день тренировка и подходит ли она под фильтр
        const isMatch = cellData && cellData.name && cellData.type === filter;

        if (isMatch) {
          // Если тренировка подошла, рендерим её.
          // В одиночных табах (Gym, Cardio) затяжные тренировки тоже могут занимать 2 слота,
          // поэтому сохраняем их rowspan, если они активны!
          if (cellData.rowspan > 1) {
            td.setAttribute("rowspan", cellData.rowspan);
            activeRowspanCounters[dayIndex] = cellData.rowspan - 1;
          }

          td.innerHTML = `
            <div class="timetable__lesson" data-type="${cellData.type}">
              <span class="timetable__lesson-name">${cellData.name}</span>
              <span class="timetable__lesson-coach">${cellData.coach}</span>
            </div>
          `;
        } else {
          // Если тренировки нет, или она скрылась фильтром —
          // рендерим честный пустой td. Сетка линий всегда будет идеальной!
        }

        tr.appendChild(td);
      }

      tbody.appendChild(tr);
    });
  }

  // 3. ПЕРЕКЛЮЧЕНИЕ ТАБОВ
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (tab.classList.contains("timetable__tab-btn--active")) return;

      document
        .querySelector(".timetable__tab-btn--active")
        .classList.remove("timetable__tab-btn--active");
      tab.classList.add("timetable__tab-btn--active");

      const filterValue = tab.getAttribute("data-filter");
      updateTable(filterValue);

      // --- ДОБАВЛЯЕМ ПЕРЕЗАПУСК АНИМАЦИИ ДЛЯ ОБЕРТКИ ---
      const wrapper = document.querySelector(".timetable__table-wrapper");
      if (wrapper) {
        wrapper.style.animation = "none"; // Сбрасываем старую анимацию
        wrapper.offsetHeight; // Магическая строчка (триггер перерисовки), чтобы браузер заметил сброс
        wrapper.style.animation = "fadeInTable 1s ease forwards"; // Запускаем анимацию заново!
      }
    });
  });
});
